// Full Chip Testbench

`timescale 1ns / 1ps

module half_adder_tb;

    reg A;
    reg B;

    wire Sum;
    wire Cout;

    // Instantiate the Half Adder
    half_adder dut (
        .A(A),
        .B(B),
        .Sum(Sum),
        .Cout(Cout)
    );

    initial begin

        // Generate VCD waveform
        $dumpfile("half_adder_tb.vcd");
        $dumpvars(0, half_adder_tb);

        // Test case 1: 0 + 0
        A = 1'b0;
        B = 1'b0;
        #10;

        // Test case 2: 0 + 1
        A = 1'b0;
        B = 1'b1;
        #10;

        // Test case 3: 1 + 0
        A = 1'b1;
        B = 1'b0;
        #10;

        // Test case 4: 1 + 1
        A = 1'b1;
        B = 1'b1;
        #10;

        $finish;
    end

endmodule